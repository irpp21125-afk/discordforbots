MYSQL_USER=support_bot
MYSQL_PASSWORD=BotPass2026!
MYSQL_DATABASE=support_bot
# Пароль root для контейнера MySQL (использует docker-compose)
MYSQL_ROOT_PASSWORD=RootPass2026!

